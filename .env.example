# Template only — the real values live in secrets-manager and are fetched at
# deploy time, prefixed NIDRA_DAILY_PUSH_ (repo name uppercased, hyphens to
# underscores). The prefix is stripped before it reaches the container, so add
# NIDRA_DAILY_PUSH_NTFY_BASE to populate NTFY_BASE below.

# ── Nidra backend (required) ──────────────────────────────────────────────
NIDRA_API_URL=https://api.example.com
NIDRA_ADMIN_USER=
NIDRA_ADMIN_PASS=

# ── status pings (required in practice: this is how a failure reaches you) ─
NTFY_BASE=https://ntfy.sh
NTFY_TOPIC_OK=
NTFY_TOPIC_FAIL=
NTFY_TOKEN=

# ── dashboard ─────────────────────────────────────────────────────────────
# The ONLY guard on the route that broadcasts to the whole member base.
# 32+ random chars:  openssl rand -base64 32
DASHBOARD_TOKEN=
# Included in ntfy pings so a page links back to the dashboard.
DASHBOARD_URL=

# ── nightly git mirror (optional; skipped entirely when unset) ─────────────
# Fine-grained PAT, this repo only, Contents: read and write.
GITHUB_TOKEN=
GITHUB_REPO=sarvin-5124/nidra-daily-push
GITHUB_BRANCH=main

# ── tuning ────────────────────────────────────────────────────────────────
# Page when more than this percent of the audience does not receive a push.
# Historical normal band is 0.27-4.79%. Defaults to 10 when unset.
FAIL_RATE_ALERT=10
